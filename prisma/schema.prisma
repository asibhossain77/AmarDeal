generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String   @unique
  password  String
  isSeller        Boolean  @default(false)
  sellerDisabled  Boolean  @default(false)
  isActive        Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  resetToken      String?
  resetTokenExpiry DateTime?
  googleId        String?
  imageLink       String?
  businessName     String?
  businessBio      String?
  whatsappNumber   String?
  referralCode     String?  @unique
  referredBy       String?
  referrer         User?   @relation("UserReferral", fields: [referredBy], references: [id])
  affiliateBalance Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dealsAsBuyer      Deal[]              @relation("DealBuyer")
  dealsAsSeller     Deal[]              @relation("DealSeller")
  dealsCreated      Deal[]              @relation("DealCreator")
  admin             Admin?
  notifications     Notification[]
  reviews           Review[]
  affiliateEarnings AffiliateEarning[]  @relation("AffiliateOwner")
  referredUsers     User[]              @relation("UserReferral")
  affiliateWithdrawals AffiliateWithdrawal[]
  digitalProducts   DigitalProduct[]
  productChatMessages ProductChatMessage[]
  sellerApplications  SellerApplication[]
  sellerFollowers    SellerFollower[] @relation("SellerFollowers")
  followingSellers   SellerFollower[] @relation("FollowingSellers")
  sellerReviews      SellerReview[]   @relation("SellerReviews")
  userSellerReviews  SellerReview[]   @relation("UserSellerReviews")
  pushSubscriptions  PushSubscription[]
}

model Admin {
  id           String   @id @default(cuid())
  userId       String   @unique
  role         String   @default("support")
  permissions  String   @default("[]")
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Deal {
  id               String   @id @default(cuid())
  title            String
  amount           Float
  status           String   @default("created")
  buyerId          String
  sellerId         String?
  creatorId        String
  terms            String?
  paymentMethodId  String?
  senderNumber     String?
  transactionId    String?
  paymentAmount    Float?
  platformFee      Float?
  rejectionReason  String?
  productId         String?
  adminCalled      Boolean  @default(false)
  adminCalledAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buyer         User           @relation("DealBuyer", fields: [buyerId], references: [id])
  seller        User?          @relation("DealSeller", fields: [sellerId], references: [id])
  creator       User           @relation("DealCreator", fields: [creatorId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  product       DigitalProduct? @relation(fields: [productId], references: [id])
}

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  accountNumber String
  accountType   String   @default("personal")
  status        String   @default("active")
  sortOrder     Int      @default(0)
  color         String   @default("#84CC16")
  image         String?
  instructions  String?
  qrImage       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deals Deal[]
}

model PlatformSetting {
  key   String @id
  value String
  updatedAt DateTime @updatedAt
}

model FeeRule {
  id             Int      @id @default(autoincrement())
  minimum_amount Int
  maximum_amount Int      @default(0)
  fee            Int
  is_active      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  dealId    String?
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactInfo {
  id            String   @id @default(cuid())
  phone         String?
  email         String?
  whatsapp      String?
  telegram      String?
  facebook      String?
  facebookPage  String?
  facebookGroup String?
  telegramGroup String?
  address       String?
  updatedAt     DateTime @updatedAt
}

model Payout {
  id           String   @id @default(cuid())
  dealId       String
  type         String
  recipientId  String
  amount       Float
  accountType  String
  accountNumber String
  accountName  String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  dealId     String
  senderId   String
  role       String?
  senderName String?
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealId, createdAt])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

model AffiliateEarning {
  id             String   @id @default(cuid())
  affiliateId    String
  dealId         String
  referredUserId String
  amount         Float
  percentage     Float
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  affiliate User @relation("AffiliateOwner", fields: [affiliateId], references: [id])

  @@unique([dealId])
  @@index([affiliateId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  isApproved Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApproved, createdAt])
  @@index([userId])
}

model AffiliateWithdrawal {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  accountType   String
  accountNumber String
  accountName   String
  status        String   @default("pending")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model DigitalProduct {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  category    String   @default("other")
  image       String?
  quantity    Int      @default(10)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatMessages ProductChatMessage[]
  deals         Deal[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model ProductChatMessage {
  id        String   @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([senderId])
}

model MarketplaceBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model SellerApplication {
  id              String   @id @default(cuid())
  userId          String
  businessName    String
  email           String
  phone           String
  whatsappNumber  String?
  verificationCode String?
  status          String   @default("pending")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model AffiliatePaymentMethod {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerFollower {
  id        String   @id @default(cuid())
  sellerId  String
  followerId String
  createdAt DateTime @default(now())

  seller  User @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  follower User @relation("FollowingSellers", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, followerId])
  @@index([sellerId])
  @@index([followerId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
}

model SellerReview {
  id        String   @id @default(cuid())
  sellerId  String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller User @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  user   User @relation("UserSellerReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([sellerId])
  @@index([userId])
}
