generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String   @unique
  password  String
  isSeller        Boolean  @default(false)
  isActive        Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealsAsBuyer  Deal[] @relation("DealBuyer")
  dealsAsSeller Deal[] @relation("DealSeller")
  dealsCreated  Deal[] @relation("DealCreator")
  admin         Admin?
  notifications Notification[]
  reviews       Review[]
}

model Admin {
  id           String   @id @default(cuid())
  userId       String   @unique
  role         String   @default("support")
  permissions  String   @default("[]")
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Deal {
  id               String   @id @default(cuid())
  title            String
  amount           Float
  status           String   @default("created")
  buyerId          String
  sellerId         String?
  creatorId        String
  terms            String?
  paymentMethodId  String?
  senderNumber     String?
  transactionId    String?
  paymentAmount    Float?
  platformFee      Float?
  rejectionReason  String?
  adminCalled      Boolean  @default(false)
  adminCalledAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buyer         User           @relation("DealBuyer", fields: [buyerId], references: [id])
  seller        User?          @relation("DealSeller", fields: [sellerId], references: [id])
  creator       User           @relation("DealCreator", fields: [creatorId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
}

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  accountNumber String
  accountType   String   @default("personal")
  status        String   @default("active")
  sortOrder     Int      @default(0)
  color         String   @default("#84CC16")
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deals Deal[]
}

model PlatformSetting {
  key   String @id
  value String
  updatedAt DateTime @updatedAt
}

model FeeRule {
  id             Int      @id @default(autoincrement())
  minimum_amount Int
  maximum_amount Int      @default(0)
  fee            Int
  is_active      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  dealId    String?
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactInfo {
  id            String   @id @default(cuid())
  phone         String?
  email         String?
  whatsapp      String?
  telegram      String?
  facebook      String?
  facebookGroup String?
  address       String?
  updatedAt     DateTime @updatedAt
}

model Payout {
  id           String   @id @default(cuid())
  dealId       String
  type         String
  recipientId  String
  amount       Float
  accountType  String
  accountNumber String
  accountName  String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  dealId     String
  senderId   String
  role       String?
  senderName String?
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealId, createdAt])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  isApproved Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApproved, createdAt])
  @@index([userId])
}