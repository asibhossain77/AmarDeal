generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String   @unique
  password  String
  isSeller        Boolean  @default(false)
  sellerDisabled  Boolean  @default(false)
  sellerRole      String   @default("personal") // 'personal' | 'business' (business = admin-approved Verified Business Seller)
  businessVerified Boolean @default(false) // true only when a business application is approved by admin
  isActive        Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  resetToken      String?
  resetTokenExpiry DateTime?
  googleId        String?
  imageLink       String?
  businessName     String?
  businessBio      String?
  whatsappNumber   String?
  referralCode     String?  @unique
  referredBy       String?
  referrer         User?   @relation("UserReferral", fields: [referredBy], references: [id])
  affiliateBalance Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dealsAsBuyer      Deal[]              @relation("DealBuyer")
  dealsAsSeller     Deal[]              @relation("DealSeller")
  dealsCreated      Deal[]              @relation("DealCreator")
  admin             Admin?
  notifications     Notification[]
  reviews           Review[]
  affiliateEarnings AffiliateEarning[]  @relation("AffiliateOwner")
  referredUsers     User[]              @relation("UserReferral")
  affiliateWithdrawals AffiliateWithdrawal[]
  digitalProducts   DigitalProduct[]
  productChatMessages ProductChatMessage[]
  sellerApplications  SellerApplication[]
  sellerFollowers    SellerFollower[] @relation("SellerFollowers")
  followingSellers   SellerFollower[] @relation("FollowingSellers")
  sellerReviews      SellerReview[]   @relation("SellerReviews")
  userSellerReviews  SellerReview[]   @relation("UserSellerReviews")
  pushSubscriptions  PushSubscription[]
  payoutAccounts     PayoutAccount[]
  sellerWithdrawals  SellerWithdrawal[]
  productDownloads   ProductDownload[]
  auctionsSold       Auction[] @relation("AuctionSeller")
  auctionBids        Bid[]     @relation("AuctionBids")
  auctionsWon        Auction[] @relation("AuctionWinner")
  topBidAuctions     Auction[] @relation("AuctionTopBidder")
  oauthAuthCodes     OAuthAuthorizationCode[]
  marketplaceOrdersAsBuyer  MarketplaceOrder[] @relation("MarketplaceOrderBuyer")
  marketplaceOrdersAsSeller MarketplaceOrder[] @relation("MarketplaceOrderSeller")
  adminAuditLogs            AdminAuditLog[]
  ledgerEntries             SellerLedgerEntry[]
}

model Admin {
  id           String   @id @default(cuid())
  userId       String   @unique
  role         String   @default("support")
  permissions  String   @default("[]")
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Deal {
  id               String   @id @default(cuid())
  title            String
  amount           Float
  status           String   @default("created")
  buyerId          String
  sellerId         String?
  creatorId        String
  terms            String?
  paymentMethodId  String?
  senderNumber     String?
  transactionId    String?
  paymentAmount    Float?
  platformFee      Float?
  rejectionReason  String?
  productId         String?
  productOptionId  String?
  adminCalled      Boolean  @default(false)
  adminCalledAt    DateTime?
  // Seller work-duration commitment (set after admin verifies payment)
  workDays         Int?      // কত দিনে কাজ সম্পন্ন হবে
  workDeadlineAt   DateTime? // commitment expiry = set time + workDays days
  // Unresponsive-buyer auto-complete flow (seller reminder → 30-day grace)
  deliveredAt         DateTime? // when seller marked the work delivered (in_delivery)
  reminderEmailSentAt DateTime? // seller → buyer "please confirm delivery" reminder email
  autoCompleteAt      DateTime? // reminderEmailSentAt + 30 days → cron auto-completes deal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buyer         User           @relation("DealBuyer", fields: [buyerId], references: [id])
  seller        User?          @relation("DealSeller", fields: [sellerId], references: [id])
  creator       User           @relation("DealCreator", fields: [creatorId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  product       DigitalProduct? @relation(fields: [productId], references: [id])
  productOption ProductOption?  @relation(fields: [productOptionId], references: [id], onDelete: SetNull)
}

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  accountNumber String
  accountType   String   @default("personal")
  status        String   @default("active")
  sortOrder     Int      @default(0)
  color         String   @default("#84CC16")
  image         String?
  instructions  String?
  qrImage       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deals Deal[]
  marketplaceOrders MarketplaceOrder[]
}

model PlatformSetting {
  key   String @id
  value String
  updatedAt DateTime @updatedAt
}

model FeeRule {
  id             Int      @id @default(autoincrement())
  minimum_amount Int
  maximum_amount Int      @default(0)
  fee            Int
  is_active      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  dealId      String?
  type        String
  title       String
  message     String
  relatedType String?
  relatedId   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model ContactInfo {
  id            String   @id @default(cuid())
  phone         String?
  email         String?
  whatsapp      String?
  telegram      String?
  facebook      String?
  facebookPage  String?
  facebookGroup String?
  telegramGroup String?
  address       String?
  updatedAt     DateTime @updatedAt
}

model Payout {
  id           String   @id @default(cuid())
  dealId       String
  type         String
  recipientId  String
  amount       Float
  accountType  String
  accountNumber String
  accountName  String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  dealId     String
  senderId   String
  role       String?
  senderName String?
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealId, createdAt])
}

/// Deal chat attachment (document or image) — lives in a SEPARATE table so the
/// chat keeps working even before this table exists on a fresh database (the
/// /api/health auto-setup creates it). R2 object is deleted 3 days after the
/// message was sent (cron + lazy cleanup); the row is kept so the UI can show
/// the "ফাইলের মেয়াদ শেষ" state with the original file name.
model ChatFile {
  id        String    @id @default(cuid())
  dealId    String
  messageId String    @unique
  key       String
  fileName  String
  fileSize  Int
  fileType  String?
  expiresAt DateTime
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([dealId])
  @@index([expiresAt])
}

/// Per-user "seen" marker for a deal — powers the unread badge on the deal
/// list (My Deals / seller deals). lastReadAt is the threshold for new chat
/// messages from others; lastSeenDealUpdated snapshots deal.updatedAt so a
/// status change by the OTHER party (admin approve, seller deliver, …) counts
/// as an update, while the user's own actions never flag their own list.
/// Lives in a separate table (auto-created by /api/health) so chat keeps
/// working even before this table exists.
model DealReadState {
  id                  String   @id @default(cuid())
  dealId              String
  userId              String
  lastReadAt          DateTime
  lastSeenDealUpdated DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([dealId, userId])
  @@index([userId])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

model AffiliateEarning {
  id             String   @id @default(cuid())
  affiliateId    String
  dealId         String
  referredUserId String
  amount         Float
  percentage     Float
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  affiliate User @relation("AffiliateOwner", fields: [affiliateId], references: [id])

  @@unique([dealId])
  @@index([affiliateId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  isApproved Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isApproved, createdAt])
  @@index([userId])
}

model AffiliateWithdrawal {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  accountType   String
  accountNumber String
  accountName   String
  status        String   @default("pending")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model DigitalProduct {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  category    String   @default("other")
  image       String?
  quantity    Int      @default(10)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  status      String   @default("active")
  // "single" = one fixed price, "multi" = multiple priced options.
  // Existing products default to "single" so old listings keep working.
  productType String   @default("single")
  // ── Item type (Task 82): what kind of product this is ──
  // "physical"    = tangible item — Order Now + stock, no digital file
  // "non_physical"= every pre-existing seller product (digital file /
  //                 service). Default keeps ALL old listings non-physical —
  //                 existing products are never reclassified as physical.
  itemType     String   @default("non_physical")
  // Physical-only optional attributes (always null for non-physical items)
  condition    String?  // "new" | "used"
  shippingInfo String?  // free-text delivery / shipping information
  // ── Verified Business Seller listing extensions (Phase 2) ──
  digitalKind     String?  // non-physical classification: 'file'|'account'|'license'|'subscription'|'other'
  deliveryDetails String?  // PRIVATE digital delivery instructions — owner/admin only, never public
  images          String?  // JSON array of gallery image URLs; images[0] mirrors `image`
  // Digital product file (uploaded to R2 `files/` prefix) — null = physical/service product
  isFree      Boolean  @default(false) // free products: anyone can download without a deal
  fileKey     String?  // R2 object key — NEVER exposed to clients (secret URL)
  fileName    String?  // original display filename
  fileSize    Int?     // bytes
  fileType    String?  // mime type
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatMessages ProductChatMessage[]
  deals         Deal[]
  options       ProductOption[]
  downloads     ProductDownload[]
  marketplaceOrders MarketplaceOrder[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model ProductOption {
  id          String   @id @default(cuid())
  productId   String
  product     DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals Deal[]
  marketplaceOrders MarketplaceOrder[]

  @@index([productId, sortOrder])
}

model ProductDownload {
  id        String   @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String? // set when granted via a paid deal, null for free claims
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

model ProductChatMessage {
  id        String   @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([senderId])
}

model MarketplaceBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Admin-controlled ON/OFF switch for each SMM service category
// (social media platform). No row for a category = enabled.
// Disabled categories are hidden from the storefront and their
// services cannot be ordered; existing orders are unaffected.
model MarketplaceCategorySetting {
  id         String   @id @default(cuid())
  categoryId String   @unique
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model SellerApplication {
  id              String   @id @default(cuid())
  userId          String
  businessName    String
  email           String
  phone           String
  whatsappNumber  String?
  verificationCode String?
  applicationType String   @default("personal") // 'personal' | 'business'
  idType          String?  // business only: 'nid' | 'trade_licence'
  idNumber        String?  // business only: NID or trade licence number
  documentImage   String?  // business only: uploaded NID/licence photo (R2 URL)
  status          String   @default("pending")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model AffiliatePaymentMethod {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerFollower {
  id        String   @id @default(cuid())
  sellerId  String
  followerId String
  createdAt DateTime @default(now())

  seller  User @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  follower User @relation("FollowingSellers", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, followerId])
  @@index([sellerId])
  @@index([followerId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
}

model SellerReview {
  id        String   @id @default(cuid())
  sellerId  String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller User @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  user   User @relation("UserSellerReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@index([sellerId])
  @@index([userId])
}

// Saved withdrawal accounts (bkash/nagad/rocket/bank) for sellers.
// NOTE: /api/user/payout-accounts + payout-accounts-panel existed before this
// model did — adding it fixes that long-broken feature.
model PayoutAccount {
  id           String   @id @default(cuid())
  userId       String
  accountType  String
  accountName  String
  accountNumber String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Nilam (Auction) ──────────────────────────────────────────────────
// Sellers list a product for auction (starting price + end time).
// Buyers bid; when the timer expires the highest bidder automatically
// gets an escrow Deal created with the seller (status 'created').
// Finalization is LAZY — any read/bid on an expired auction finalizes it.
model Auction {
  id              String   @id @default(cuid())
  title           String
  description     String
  category        String   @default("other")
  image           String?
  sellerId        String
  seller          User     @relation("AuctionSeller", fields: [sellerId], references: [id])
  startPrice      Float
  currentPrice    Float?   // highest bid so far — null until first bid
  highestBidderId String?
  highestBidder   User?    @relation("AuctionTopBidder", fields: [highestBidderId], references: [id])
  bidCount        Int      @default(0)
  // active → bids open | sold → winner + deal created | ended → expired, no bids | cancelled → seller cancelled (no bids)
  status          String   @default("active")
  endsAt          DateTime
  winnerId        String?
  winner          User?    @relation("AuctionWinner", fields: [winnerId], references: [id])
  dealId          String?  // escrow deal created for the winner
  finalPrice      Float?   // winning amount at close (audit copy of currentPrice)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bids            Bid[]

  @@index([status, endsAt])
  @@index([sellerId])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation("AuctionBids", fields: [bidderId], references: [id])
  amount    Float
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
  @@index([bidderId])
}

// Seller balance withdrawals — pool-based (NOT per-deal).
// Balance = Σ completed deal amounts − Σ legacy per-deal seller_payouts − Σ withdrawals
// (pending + approved + completed). Computed server-side in src/lib/seller-balance.ts.
model SellerWithdrawal {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  accountType   String
  accountName   String
  accountNumber String
  status        String   @default("pending") // pending | approved | completed | rejected
  adminNote     String?
  // ── Phase 7: verified payment evidence — a payout can NEVER be marked
  //    completed without a payment reference (bKash/bank TxnID etc.) ──
  paymentReference String?
  paymentNote      String?
  completedById    String?
  completedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

// ═════════════════════════════════════════════════════════
// Phase 7 — Seller financial ledger (append-only, itemized).
// Written ONLY by verified server flows at the moment authoritative
// state changes; @@unique([sourceType, sourceId, type]) makes every
// write idempotent — duplicate financial rows are impossible.
// Admin Deal transactions (sourceType 'deal') and Marketplace Order
// earnings (sourceType 'marketplace_order') stay distinguishable.
// Commission % is snapshotted into `details` at write time — later
// rate changes never rewrite history.
// ═════════════════════════════════════════════════════════
model SellerLedgerEntry {
  id         String @id @default(cuid())
  sellerId   String
  seller     User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // marketplace_order | deal | withdrawal | adjustment
  sourceType String
  // Transaction reference: order id / deal id / withdrawal id / adjustment id
  sourceId   String
  // sale | commission | refund | commission_reversal | deal_earning | payout | adjustment
  type       String
  // Signed amount: + credit to seller, − debit from seller (BDT)
  amount     Float
  description String
  // JSON: { orderNumber?, dealTitle?, rate?, paymentReference?, reason?, adminName?, backfilled? }
  details    String?
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId, type])
  @@index([sellerId, createdAt])
  @@index([sellerId, type])
  @@index([sourceType, sourceId])
}

// ── OAuth 2.0 Authorization Code (single-use, short-lived) ──
// Used by the "Continue with Midman" provider for verify.midman.bd.
// Only a SHA-256 hash of each code is stored — raw codes never touch the DB.
model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  userId              String
  redirectUri         String
  scope               String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════
// Marketplace Direct Orders — admin-owned SMM service store.
// Fully separate from Deal (escrow): no Deal rows are created
// for marketplace orders. Only admins manage services.
// ═══════════════════════════════════════════════════════════

model MarketplaceService {
  id                String   @id @default(cuid())
  name              String
  category          String   @default("other")
  description       String
  pricePerThousand  Float
  minQuantity       Int      @default(100)
  maxQuantity       Int      @default(100000)
  linkTypes         String   @default("[]")
  deliveryEstimate  String?
  instructions      String?
  status            String   @default("draft")
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders MarketplaceOrder[]

  @@index([status, isActive, sortOrder])
  @@index([category])
}

model MarketplaceOrder {
  id                String    @id @default(cuid())
  orderNumber       String    @unique
  userId            String
  user              User      @relation("MarketplaceOrderBuyer", fields: [userId], references: [id])
  // sellerId is set for product ("Order Now") orders; null = platform-owned
  // (admin SMM service orders and admin-sold products).
  sellerId          String?
  seller            User?     @relation("MarketplaceOrderSeller", fields: [sellerId], references: [id])
  // serviceId is set for admin-owned SMM service direct orders; null for product orders
  serviceId         String?
  service           MarketplaceService? @relation(fields: [serviceId], references: [id])
  // Denormalized display title: service name (service orders) or product
  // title + option (product orders) — keeps existing queries untouched.
  serviceName       String
  // productId is set for product orders placed via "Order Now" on a product page
  productId         String?
  product           DigitalProduct? @relation(fields: [productId], references: [id])
  productOptionId   String?
  option            ProductOption? @relation(fields: [productOptionId], references: [id])
  linkUrl           String?
  linkType          String?
  quantity          Int
  pricingUnit       String    @default("per_1000")
  unitPriceAtOrder  Float
  totalAmount       Float
  status            String    @default("pending_payment")
  paymentStatus     String    @default("unpaid")
  paymentMethodName String?
  paymentMethodId   String?
  senderNumber      String?
  transactionId     String?
  piprapayInvoiceId String?   @unique
  paidAt            DateTime?
  paymentVerifiedBy String?
  fulfilmentNote    String?
  startCount        Int?
  remains           Int?
  idempotencyKey    String    @unique
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?
  cancelReason      String?
  refundedAt        DateTime?
  customerNote      String?

  // ── Phase 3: physical delivery info (buyer-supplied at order time,
  //    visible only to buyer / order seller / admin — never public) ──
  buyerName         String?
  buyerPhone        String?
  addressLine       String?
  city              String?
  postalCode        String?
  deliveryNote      String?
  // ── Phase 3: dispute flow ──
  disputeReason     String?
  disputedAt        DateTime?
  // ── Phase 5: physical delivery tracking (seller-supplied) ──
  courierName       String?
  trackingNumber    String?
  dispatchDate      DateTime?
  estimatedDeliveryDate DateTime?
  shippingNote      String?
  deliveredAt       DateTime?
  // ── Phase 5: secure digital delivery content (order-scoped — the ONLY
  //    copy of seller→buyer digital handover data; never on product pages,
  //    list APIs select explicit fields so it cannot leak) ──
  deliveryContent   String?
  deliveryContentAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  events        MarketplaceOrderEvent[]
  // ── Phase 6: buyer protection ──
  cancellationRequest OrderCancellationRequest?
  refundRequest       RefundRequest?
  dispute             OrderDispute?

  @@index([userId, createdAt])
  @@index([sellerId, status])
  @@index([sellerId, createdAt])
  @@index([status])
  @@index([serviceId])
  @@index([productId])
  @@index([transactionId])
}

model MarketplaceOrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?
  toStatus   String?
  message    String?
  actorType  String   @default("system")
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// Phase 6 — Buyer Protection: cancellation, refunds, disputes.
// All money movement stays with the EXISTING admin verification
// flows: a cancellation approval on a PAID order can never cancel
// the order directly — it can only spawn a RefundRequest, and an
// order is marked refunded ONLY after the admin records a verified
// manual refund (reference + proof).
// ═══════════════════════════════════════════════════════════

// Buyer-initiated cancellation request (seller/admin responds).
// Eligibility is enforced server-side in src/lib/order-protection.ts:
// unpaid pending_payment orders cancel directly (existing flow);
// payment-submitted / paid-but-unfulfilled orders go through here.
model OrderCancellationRequest {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedByRole String   @default("buyer") // buyer (seller-initiated uses direct cancel)
  reason          String
  // pending → approved | rejected
  status          String   @default("pending")
  decidedById     String?
  decidedByRole   String?  // seller | admin
  decisionNote    String?
  decidedAt       DateTime?
  // Set when approval spawned a RefundRequest (order was already paid):
  // the order itself is only cancelled after the refund is verified.
  refundRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

// Buyer-initiated refund request — one per order (prevents duplicates).
// Status flow: requested → under_review → approved → processing → refunded
//                                       └→ rejected (any pre-refunded state)
// 'refunded' requires refundReference (+ proof) — never set automatically.
model RefundRequest {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedById   String
  reason          String
  // JSON array of evidence objects [{key,fileName,fileSize,fileType}]
  evidence        String?
  // Requested amount — validated server-side: 0 < amount <= verified paid total
  amount          Float
  // requested | under_review | approved | rejected | processing | refunded
  status          String   @default("requested")
  adminNote       String?  // rejection reason / decision note (buyer-visible)
  infoRequest     String?  // admin's "additional information needed" note
  reviewedById    String?
  reviewedAt      DateTime?
  refundMethod    String?  // manual channel used (bKash/Nagad/bank…)
  refundReference String?  // transaction id of the ACTUAL manual refund
  refundProof     String?  // JSON array — screenshot/proof of the manual refund
  refundedAt      DateTime?
  cancellationRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

// Order dispute with a timestamped two-sided evidence thread.
// Buyer AND seller can raise one per order. While a dispute is open on a
// not-yet-completed order, the order itself carries status 'disputed'
// (existing vocabulary); on completion-stage orders the record stands alone.
model OrderDispute {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedById    String
  raisedByRole  String   // buyer | seller
  // Order status before the dispute flipped it to 'disputed' — lets an
  // admin cleanly resume fulfilment when a dispute is rejected.
  preDisputeStatus String?
  // item_not_received | not_as_described | damaged_physical | incorrect_digital | other
  category      String   @default("other")
  description   String
  // JSON array of evidence objects [{key,fileName,fileSize,fileType}]
  evidence      String?
  // open | under_review | resolved | rejected
  status        String   @default("open")
  resolution    String?  // admin resolution notes
  // refund | cancel | complete | rejected | none
  outcome       String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      OrderDisputeMessage[]

  @@index([status, createdAt])
}

// Timestamped dispute conversation — descriptions, screenshots, evidence
// from both parties plus the reviewing admin.
model OrderDisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     OrderDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  senderRole  String   // buyer | seller | admin
  text        String
  // JSON array of attachment objects [{key,fileName,fileSize,fileType}]
  attachments String?
  createdAt   DateTime @default(now())

  @@index([disputeId, createdAt])
}

// Audit trail for every sensitive admin decision (refund/cancellation/
// dispute actions, forced order transitions). Rows are write-once.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminName  String?
  action     String   // e.g. refund_approve, refund_completed, dispute_resolve
  targetType String   // refund_request | cancellation_request | dispute | order
  targetId   String?
  orderId    String?
  details    String?  // JSON payload snapshot
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}
