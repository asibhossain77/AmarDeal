# Local development (SQLite)
DATABASE_URL=file:./db/custom.db

# Turso (Vercel production — set in Vercel dashboard, not here)
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# ── Brevo Email (SMTP) ──
# 1. Go to https://app.brevo.com → Settings → SMTP & API
# 2. Generate an SMTP Key (starts with xkeysib-...)
# 3. Set your verified sender email as BREVO_SMTP_USER
BREVO_SMTP_KEY=your-brevo-smtp-key-here
BREVO_SMTP_USER=your-verified-sender@amardeal.com

# Optional: custom From email (must be verified in Brevo)
# BREVO_FROM_EMAIL=noreply@amardeal.com