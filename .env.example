# Local development (SQLite)
DATABASE_URL=file:./db/custom.db

# Turso (Vercel production — set in Vercel dashboard, not here)
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# ── Brevo Email (SMTP) ──
# 1. Go to https://app.brevo.com → Settings → SMTP & API
# 2. Generate an SMTP Key
# 3. Login = the @smtp-brevo.com address Brevo shows you (NOT your email!)
# 4. Set BREVO_FROM_EMAIL if you want a different From address
BREVO_SMTP_KEY=your-brevo-smtp-key-here
BREVO_SMTP_USER=xxxxxx@smtp-brevo.com

# Optional: custom From email (must be verified in Brevo)
# BREVO_FROM_EMAIL=noreply@midman.bd

# Public site URL (for referral links, OG tags, etc.)
NEXT_PUBLIC_APP_URL=https://midman.bd

# ── Cloudflare R2 (Image Storage) ──
# Set these in Vercel dashboard (or .env for local dev)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=midman-storage
R2_PUBLIC_URL=https://cdn.midman.bd
# ── Meta Pixel + Conversions API (Facebook Ads) ──
# 1. Meta Events Manager → Data Sources → your Pixel → copy the Pixel ID (digits only)
# 2. Business Settings → System Users → create token with ads_management (CAPI)
# 3. Set both in Vercel (Production + Preview)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: while validating, route events to Meta's "Test Events" tool
META_CAPI_TEST_EVENT_CODE=
# Optional: override the Graph API base (local testing against a mock collector only)
# META_CAPI_URL=https://graph.facebook.com/v21.0
