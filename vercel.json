{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.midman.bd"
        }
      ],
      "destination": "https://midman.bd/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-chat-files",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/auto-complete-deals",
      "schedule": "30 4 * * *"
    }
  ]
}
